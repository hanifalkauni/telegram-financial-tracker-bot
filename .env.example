# =================================================================
# SETORSINI AI BOT - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =================================================================

# 1. Telegram Bot Token (User Bot dari @BotFather)
BOT_TOKEN=your_user_bot_token_here

# 2. Telegram Bot Token (Admin Bot dari @BotFather - Opsional)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# 3. Vercel Webhook Security Secret Token (String acak rahasia buatan Anda)
TELEGRAM_SECRET_TOKEN=your_random_secret_token_here

# 4. Google Gemini API Key (Bisa dipisahkan koma untuk Multi-Key Auto Fallback: KEY1,KEY2)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Supabase Credentials (URL & service_role Secret Key)
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key_here

# 6. Admin Master Code (Kode rahasia buatan Anda untuk aktivasi Admin)
ADMIN_MASTER_CODE=your_master_admin_code_here
